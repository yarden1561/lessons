# MongoDB Atlas connection string.
# Atlas UI -> Cluster -> Connect -> Drivers. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# MongoDB AI / embeddings endpoint.
API_ENDPOINT=ai.mongodb.com

# Voyage AI API key, used to generate the embeddings stored in the vector index.
# https://dash.voyageai.com/
VOYAGER_API_KEY=your-voyage-api-key-here
